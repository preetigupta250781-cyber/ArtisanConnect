# ==========================================
# ArtisanConnect Root .env.example
# Copy this to the appropriate subfolders as needed.
# ==========================================

# ------------------------------------------
# AI Service (/ai-service/.env)
# ------------------------------------------
# Port for the AI Service
PORT=8000

# Bhashini API Credentials
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_ULCA_KEY=your_bhashini_ulca_key
BHASHINI_INFERENCE_KEY=your_bhashini_inference_key

# Groq API Key
GROQ_API_KEY=your_groq_api_key

# ------------------------------------------
# Backend Gateway (/backend/.env)
# ------------------------------------------
# Port for the Node.js API Gateway
PORT=3000

# Connection to Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Connection to AI Service
AI_SERVICE_URL=http://localhost:8000

# ------------------------------------------
# Mobile App (/mobile/.env)
# Note: For Expo, these need to be prefixed with EXPO_PUBLIC_
# ------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:3000
# EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
